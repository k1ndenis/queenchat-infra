{"uid":"queenchat-postgresql","title":"PostgreSQL","schemaVersion":41,"version":2,"panels":[{"id":1,"type":"stat","title":"PostgreSQL status","gridPos":{"x":0,"y":0,"w":4,"h":4},"targets":[{"expr":"pg_up"}]},{"id":2,"type":"stat","title":"Connection usage","gridPos":{"x":4,"y":0,"w":4,"h":4},"targets":[{"expr":"100*sum(pg_stat_database_numbackends)/max(pg_settings_max_connections)"}],"fieldConfig":{"defaults":{"unit":"percent"}}},{"id":3,"type":"stat","title":"Database size","gridPos":{"x":8,"y":0,"w":4,"h":4},"targets":[{"expr":"sum(pg_database_size_bytes)"}],"fieldConfig":{"defaults":{"unit":"bytes"}}},{"id":4,"type":"stat","title":"Long transaction","gridPos":{"x":12,"y":0,"w":4,"h":4},"targets":[{"expr":"max(pg_stat_activity_max_tx_duration)"}],"fieldConfig":{"defaults":{"unit":"s"}}},{"id":5,"type":"timeseries","title":"Connections and locks","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum(pg_stat_database_numbackends)","legendFormat":"active connections"},{"expr":"max(pg_settings_max_connections)","legendFormat":"max connections"},{"expr":"sum(pg_locks_count)","legendFormat":"locks"}]},{"id":6,"type":"timeseries","title":"Transactions and deadlocks","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"sum(rate(pg_stat_database_xact_commit[5m]))","legendFormat":"commits/sec"},{"expr":"sum(rate(pg_stat_database_xact_rollback[5m]))","legendFormat":"rollbacks/sec"},{"expr":"sum(increase(pg_stat_database_deadlocks[15m]))","legendFormat":"deadlocks / 15m"}]},{"id":7,"type":"timeseries","title":"Cache hit ratio","gridPos":{"x":0,"y":12,"w":24,"h":8},"targets":[{"expr":"100*sum(rate(pg_stat_database_blks_hit[5m]))/clamp_min(sum(rate(pg_stat_database_blks_hit[5m])+rate(pg_stat_database_blks_read[5m])),1)","legendFormat":"cache hit %"}],"fieldConfig":{"defaults":{"unit":"percent"}}}]}
