{"uid":"queenchat-overview","title":"QueenChat Overview","schemaVersion":41,"version":1,"panels":[{"type":"stat","title":"RPS","targets":[{"expr":"sum(rate(http_requests_total[5m]))"}]},{"type":"stat","title":"p95 latency","targets":[{"expr":"histogram_quantile(.95, sum by(le) (rate(http_request_duration_seconds_bucket[5m])))"}]},{"type":"stat","title":"5xx %","targets":[{"expr":"100 * sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))"}]},{"type":"stat","title":"Active WS","targets":[{"expr":"sum(queenchat_websocket_connections)"}]},{"type":"timeseries","title":"Requests and status","targets":[{"expr":"sum by(status_code) (rate(http_requests_total[5m]))"}]},{"type":"timeseries","title":"Business events","targets":[{"expr":"sum(rate(queenchat_messages_sent_total[5m]))"},{"expr":"sum(rate(queenchat_users_registered_total[5m]))"},{"expr":"sum(rate(queenchat_uploads_total[5m]))"},{"expr":"sum(rate(queenchat_rate_limit_hits_total[5m]))"}]}]}
