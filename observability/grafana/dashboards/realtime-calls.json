{"uid":"queenchat-realtime","title":"Realtime / Calls","schemaVersion":41,"version":2,"panels":[{"id":1,"type":"stat","title":"Active WebSockets","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(queenchat_websocket_connections)"}]},{"id":2,"type":"timeseries","title":"WebSocket lifecycle and events","gridPos":{"x":0,"y":4,"w":12,"h":8},"targets":[{"expr":"sum by(type)(queenchat_websocket_connections)","legendFormat":"active {{type}}"},{"expr":"sum(rate(queenchat_websocket_connections_opened_total[5m]))","legendFormat":"opened/sec"},{"expr":"sum(rate(queenchat_websocket_disconnects_total[5m]))","legendFormat":"disconnected/sec"},{"expr":"sum(rate(queenchat_websocket_events_total[5m]))","legendFormat":"events/sec"},{"expr":"sum(rate(queenchat_websocket_rate_limit_total[5m]))","legendFormat":"rate limits/sec"}]},{"id":3,"type":"timeseries","title":"Calls and signalling","gridPos":{"x":12,"y":4,"w":12,"h":8},"targets":[{"expr":"sum(rate(queenchat_calls_started_total[5m]))","legendFormat":"calls started/sec"},{"expr":"sum by(signal_type)(rate(queenchat_call_signals_total[5m]))","legendFormat":"{{signal_type}}/sec"},{"expr":"sum(rate(queenchat_ice_credentials_issued_total[5m]))","legendFormat":"ICE credentials/sec"}]}]}
