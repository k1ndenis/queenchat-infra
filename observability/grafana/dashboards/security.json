{"uid":"queenchat-security","title":"Security","schemaVersion":41,"version":2,"panels":[{"id":1,"type":"timeseries","title":"Authentication events","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(queenchat_login_success_total[5m]))","legendFormat":"successful logins/sec"},{"expr":"sum(rate(queenchat_login_failed_total[5m]))","legendFormat":"failed logins/sec"},{"expr":"sum(rate(queenchat_users_registered_total[5m]))","legendFormat":"registrations/sec"}]},{"id":2,"type":"timeseries","title":"HTTP rate-limit hits by policy","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"sum by(policy)(rate(queenchat_rate_limit_hits_total[5m]))","legendFormat":"{{policy}}"}]},{"id":3,"type":"timeseries","title":"Messaging and WebSocket throttling","gridPos":{"x":0,"y":8,"w":24,"h":8},"targets":[{"expr":"sum(rate(queenchat_websocket_rate_limit_total[5m]))","legendFormat":"WS throttling/sec"},{"expr":"sum(rate(queenchat_rate_limit_hits_total{policy=~\".*message.*|.*reaction.*|.*comment.*|.*invite.*\"}[5m]))","legendFormat":"message/reaction/comment/invite throttling/sec"}]}]}
